{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ccna-pwa/schemas/blueprint.schema.json",
  "title": "CCNA Blueprint",
  "type": "object",
  "required": ["domains"],
  "properties": {
    "_meta": { "type": "object" },
    "domains": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/domain" }
    }
  },
  "$defs": {
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "weightPct", "subtopics"],
      "properties": {
        "id": { "type": "string", "pattern": "^[1-6]\\.0$" },
        "name": { "type": "string" },
        "weightPct": { "type": "integer", "minimum": 1, "maximum": 100 },
        "subtopics": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/topic" }
        }
      }
    },
    "topic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": {
        "id": { "type": "string", "pattern": "^[1-6]\\.[0-9]+$" },
        "title": { "type": "string" },
        "children": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title"],
            "properties": {
              "id": { "type": "string", "pattern": "^[1-6]\\.[0-9]+\\.[a-z]$" },
              "title": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
